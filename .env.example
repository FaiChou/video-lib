# 复制为 .env，填入 R2 的 S3 密钥后将此项改为 true。
# 程序自动读取项目根目录的 .env；已有系统环境变量优先。
R2_SYNC_ENABLED=false
R2_ENDPOINT=https://f36a0956f2433246c394fdab29248e7c.r2.cloudflarestorage.com
R2_BUCKET=video-materials
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_MANIFEST_KEY=manifest.json

# 每天的同步时间，逗号分隔，使用下面指定的时区。
R2_SYNC_TIMES=07:30,12:00
R2_SYNC_TIMEZONE=Asia/Shanghai
# 服务启动后立即补同步一次。
R2_SYNC_ON_START=true

# 留空直接连接；需要代理时填写 http://127.0.0.1:7890。
# 仅使用此变量，不继承 HTTP_PROXY / HTTPS_PROXY 等全局代理设置。
R2_PROXY_URL=
