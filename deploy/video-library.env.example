# Install as /etc/default/video-library.
# KEY=value only: no "export", shell substitutions, or inline comments.
NODE_ENV=production
HOST=0.0.0.0
PORT=8876
VIDEO_DIR=/opt/video-library/videos
TZ=Asia/Shanghai
MAX_UPLOAD_BYTES=2147483648

# Optional extra request hostnames or public IPs, separated by commas.
# No protocol, port, path, or wildcard. Keep empty for interface IP access.
# Example: ALLOWED_HOSTS=203.0.113.10,video.example.com
ALLOWED_HOSTS=
